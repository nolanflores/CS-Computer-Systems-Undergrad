@startuml

left to right direction
skinparam packageStyle rectangle
actor "User" as User

package "Workout Organization & Planning System" {
    ' User UseCases
    usecase "Create Workout Plan" as UC1
    usecase "View & Select Workout Plans" as UC2
    usecase "Log Completed Workouts" as UC3
    usecase "Edit Individual Workout Plans" as UC4

    User --> UC1
    User --> UC2
    User --> UC3
    User --> UC4
}
