<!DOCTYPE html>
<html>
    <head>
        <title>Mini Games</title>
        <link rel="stylesheet" href="/style.css">
    </head>
    <body>
        <header>
            <h1 class="loginHeader">Mini Games</h1>
        </header>
        <main class="loginPage">
            <div class="loginCard">
                <h2 class="loginTitle">Welcome to CS290 Mini Games!</h2>
                <div class="inputContainer">
                    <label class="usernameLabel" for="username">Enter Your Username</label>
                    <input name="username" id="username"/>
                    <div class="playButtonContainer">
                        <button id="playButton">Play!</button>
                    </div>
                </div>
            </div>
        </main>
    </body>
    <script src="/scripts/login.js"></script>
</html>