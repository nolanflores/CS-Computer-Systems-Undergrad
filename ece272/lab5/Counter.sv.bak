module Counter
#parameter (N = 4)(
	input logic clock,
	input logic clear_n,
	input logic enable_n,
	output logic [N-1:0] count
);

always_ff @(posedge clock) begin
    if (clear_n == 1'b0) begin
        // Set `q` to 0 when `clear_n` is low (active)
        count <= '0;
    end else if (enable_n == 1'b0) begin
        count <= count + 1'b1;
    end
end

endmodule