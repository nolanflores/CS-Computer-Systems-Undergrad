	eq_wire[] = ( w_anode618w[3..3], w_anode607w[3..3], w_anode596w[3..3], w_anode585w[3..3], w_anode574w[3..3], w_anode563w[3..3], w_anode552w[3..3], w_anode534w[3..3]);
